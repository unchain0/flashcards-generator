POSTGRES_DB=flashcards
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=replace-with-a-long-random-password
FLASHCARDS_SESSION_SECRET=replace-with-a-long-random-secret
FLASHCARDS_AUTH_LOOKUP_SECRET=replace-with-a-different-long-random-secret
# Use only for the first provisioning, then remove it and create users with
# `python -m flashcards_generator.delivery.web.user_admin create`.
FLASHCARDS_BOOTSTRAP_PASSWORD=replace-with-a-long-password
FLASHCARDS_PORT=8000
FLASHCARDS_DATA_DIR=./data
FLASHCARDS_CORS_ORIGINS=[]
FLASHCARDS_SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production
# Rust services use the unchain0 project DSNs by default. Override when needed:
# FLASHCARDS_WEB_SENTRY_DSN=https://public-key@host/project-id
# FLASHCARDS_COMPANION_SENTRY_DSN=https://public-key@host/project-id
